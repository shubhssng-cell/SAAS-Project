{
  "name": "ipmat-ai-prep",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "packages/domain/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace @ipmat/db",
    "db:migrate:diff": "npm run migrate:diff --workspace @ipmat/db",
    "db:migrate:dev": "npm run migrate:dev --workspace @ipmat/db",
    "db:seed": "npm run seed --workspace @ipmat/db"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
