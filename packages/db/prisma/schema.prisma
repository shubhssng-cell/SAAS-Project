// Prisma schema for the IPMAT vertical slice — see docs/DATABASE.md for the
// authoritative design rationale. This is the FULL Phase 1 domain model
// (per docs/MASTER_PLAN.md Phase 1): tables beyond Exam/Concept/Question
// exist with correct constraints from day one, but no application code
// reads or writes Attempt/Autopsy/MasteryState until Phase 4-5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Exam catalog — data, not code (docs/DATABASE.md "Exam structure is data")
// ---------------------------------------------------------------------

model Exam {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  examDateRule Json     @map("exam_date_rule")
  createdAt    DateTime @default(now()) @map("created_at")

  sections           Section[]
  enrollments        Enrollment[]
  prepPhaseTemplates PrepPhaseTemplate[]
  questions          Question[]

  @@map("exams")
}

model Section {
  id     String @id @default(uuid())
  examId String @map("exam_id")
  name   String
  order  Int

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  questions Question[]

  @@unique([examId, name])
  @@index([examId])
  @@map("sections")
}

model Chapter {
  id        String @id @default(uuid())
  sectionId String @map("section_id")
  name      String
  order     Int

  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  concepts  Concept[]
  questions Question[]

  @@unique([sectionId, name])
  @@index([sectionId])
  @@map("chapters")
}

// ---------------------------------------------------------------------
// Concept Universe — a real graph, not a flat tag list
// ---------------------------------------------------------------------

enum ConceptStatus {
  draft
  curated
  ai_assisted
  published
}

model Concept {
  id          String        @id @default(uuid())
  chapterId   String        @map("chapter_id")
  name        String
  description String?
  status      ConceptStatus @default(draft)

  chapter             Chapter                 @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  relationsFrom       ConceptRelation[]       @relation("RelationFrom")
  relationsTo         ConceptRelation[]       @relation("RelationTo")
  depth               ConceptDepth?
  lensAnalyses        ExaminerLensAnalysis[]
  lensPrerequisiteFor ExaminerLensAnalysis[]  @relation("LensPrerequisite")
  patternFamilies     QuestionPatternFamily[]
  taxonomyCells       PatternTaxonomyCell[]
  questionsPrimary    Question[]              @relation("QuestionConcept")
  masteryStates       MasteryState[]

  @@unique([chapterId, name])
  @@index([chapterId])
  @@map("concepts")
}

// Structured "concept depth" content (docs/QUESTION_ENGINE.md §1a) — kept
// as typed JSON substructures per section rather than one text blob, so
// e.g. just the shortcuts or just the common traps can be queried and
// rendered independently. See packages/domain/concept-graph/src/depth.ts
// for the substructure shapes (Formula, Method, Shortcut, ...).
model ConceptDepth {
  id                    String        @id @default(uuid())
  conceptId             String        @unique @map("concept_id")
  definition            String
  intuition             String
  formulas              Json
  methods               Json
  alternativeMethods    Json          @map("alternative_methods")
  shortcuts             Json
  commonMisconceptions  Json          @map("common_misconceptions")
  commonTraps           Json          @map("common_traps")
  applicationAreas      Json          @map("application_areas")
  difficultyProgression Json          @map("difficulty_progression")
  status                ConceptStatus @default(draft)
  createdAt             DateTime      @default(now()) @map("created_at")

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@map("concept_depths")
}

// Eight distinct relationship types (docs/DECISIONS.md D-013) — deliberately
// not flattened into a single "related" bucket. See the domain-layer
// documentation in packages/domain/concept-graph/src/types.ts for what each
// one specifically means and how it differs from its neighbors.
enum RelationType {
  prerequisite
  foundational
  directly_related
  commonly_combined
  application
  dependent
  advanced_extension
  related_but_distinct
}

// Is the relationship a hard gate, a nice-to-have, or only relevant in some contexts?
enum RequirementLevel {
  required
  optional
  contextual
}

// How sure we are this relationship is real and correctly characterized.
enum Certainty {
  confirmed
  probable
  speculative
}

enum RelationSource {
  human
  ai_suggested
}

model ConceptRelation {
  id                          String           @id @default(uuid())
  fromConceptId               String           @map("from_concept_id")
  toConceptId                 String           @map("to_concept_id")
  type                        RelationType
  rationale                   String
  sharedKnowledge             String           @map("shared_knowledge")
  usefulForQuestionGeneration Boolean          @map("useful_for_question_generation")
  requirementLevel            RequirementLevel @map("requirement_level")
  certainty                   Certainty
  source                      RelationSource

  fromConcept Concept @relation("RelationFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConcept   Concept @relation("RelationTo", fields: [toConceptId], references: [id], onDelete: Cascade)

  @@unique([fromConceptId, toConceptId, type])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@map("concept_relations")
}

// ---------------------------------------------------------------------
// Examiner Lens — versioned, stored analysis (docs/QUESTION_ENGINE.md §2)
// ---------------------------------------------------------------------

enum LensStatus {
  draft
  reviewed
  published
}

// Who produced this analysis — distinct from LensStatus (which tracks the
// review workflow regardless of who authored it). Phase 2's Percentages
// analysis is human-authored (docs/MASTER_PLAN.md Phase 2 excludes
// large-scale AI generation); generatedByProvider/promptVersion only apply
// once authoredBy = ai.
enum AuthorshipSource {
  human
  ai
}

// Finalized shape (docs/QUESTION_ENGINE.md §2): "what is tested" is four
// normalized fields, not one Json blob; testingModes is the controlled
// 10-value vocabulary; errorModes and difficultyDimensions stay Json
// because they're small, internally-cohesive structures that are always
// read/written whole, never queried by a sub-field. Deliberately has NO
// "combinations" column — that list is always derived live from
// ConceptRelation via deriveCombinations() (see packages/domain/examiner-
// lens), never cached here, so it can never drift from the graph it's
// supposed to reflect (same "derived, not stored" discipline as coverage
// and mastery).
model ExaminerLensAnalysis {
  id                         String           @id @default(uuid())
  conceptId                  String           @map("concept_id")
  version                    Int
  whatIsTestedConcept        String           @map("what_is_tested_concept")
  whatIsTestedSubconcept     String           @map("what_is_tested_subconcept")
  whatIsTestedSkill          String           @map("what_is_tested_skill")
  whatIsTestedPrerequisiteId String?          @map("what_is_tested_prerequisite_id")
  testingModes               TestingMode[]    @map("testing_modes")
  errorModes                 Json             @map("error_modes")
  difficultyDimensions       Json             @map("difficulty_dimensions")
  authoredBy                 AuthorshipSource @default(human) @map("authored_by")
  generatedByProvider        String?          @map("generated_by_provider")
  promptVersion              String?          @map("prompt_version")
  reviewedBy                 String?          @map("reviewed_by")
  status                     LensStatus       @default(draft)
  createdAt                  DateTime         @default(now()) @map("created_at")

  concept                  Concept                 @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  whatIsTestedPrerequisite Concept?                @relation("LensPrerequisite", fields: [whatIsTestedPrerequisiteId], references: [id])
  patternFamilies          QuestionPatternFamily[]
  taxonomyCells            PatternTaxonomyCell[]

  @@unique([conceptId, version])
  @@index([conceptId])
  @@map("examiner_lens_analyses")
}

// ---------------------------------------------------------------------
// The 10 legitimate ways a concept can be tested (docs/QUESTION_ENGINE.md
// §2) — a controlled vocabulary shared by pattern families and questions.
// ---------------------------------------------------------------------

enum TestingMode {
  direct
  reverse
  transformed
  combined
  contextualized
  represented_differently
  constrained
  time_pressured
  multi_step
  novel_representation
}

// ---------------------------------------------------------------------
// Question Universe — the coverage map (docs/QUESTION_ENGINE.md §3)
// ---------------------------------------------------------------------

enum CoverageStatus {
  uncovered
  in_generation
  covered
}

enum DifficultyTier {
  standard
  advanced
  hard
  extreme
  novel
}

enum PatternFamilyStatus {
  draft
  reviewed
  published
}

// A pattern describes the STRUCTURE of a question, not a numerical
// instance (docs/QUESTION_ENGINE.md §3) — one family can generate many
// valid questions. `potentialCombinationConceptIds` and
// `potentialTrapErrorTaxonomyIds` are plain reference arrays (consistent
// with Question.subconcepts/prerequisites), not enforced FKs, since a
// family's "potential" space is broader than any single concrete link.
model QuestionPatternFamily {
  id                             String              @id @default(uuid())
  conceptId                      String              @map("concept_id")
  examinerLensAnalysisId         String?             @map("examiner_lens_analysis_id")
  name                           String
  skill                          String
  description                    String
  expectedDifficultyTier         DifficultyTier      @map("expected_difficulty_tier")
  potentialCombinationConceptIds String[]            @map("potential_combination_concept_ids")
  potentialTrapErrorTaxonomyIds  String[]            @map("potential_trap_error_taxonomy_ids")
  potentialTestingModes          TestingMode[]       @map("potential_testing_modes")
  status                         PatternFamilyStatus @default(draft)
  createdAt                      DateTime            @default(now()) @map("created_at")

  concept              Concept               @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  examinerLensAnalysis ExaminerLensAnalysis? @relation(fields: [examinerLensAnalysisId], references: [id])
  taxonomyCells        PatternTaxonomyCell[]

  @@unique([conceptId, name])
  @@index([conceptId])
  @@map("question_pattern_families")
}

// One specific, concrete slice of a pattern family's space — the unit
// coverage is tracked against (docs/QUESTION_ENGINE.md §3, §6).
// `testingMode` stays a single nullable value here (unlike Question's
// array) so the natural-key uniqueness below stays simple and reliable —
// a cell is meant to be one narrow, atomic coverage target.
model PatternTaxonomyCell {
  id                     String         @id @default(uuid())
  conceptId              String         @map("concept_id")
  examinerLensAnalysisId String         @map("examiner_lens_analysis_id")
  patternFamilyId        String         @map("pattern_family_id")
  combination            String[]
  testingMode            TestingMode?   @map("testing_mode")
  trapErrorTaxonomyId    String?        @map("trap_error_taxonomy_id")
  difficultyTier         DifficultyTier @map("difficulty_tier")
  targetTimeSeconds      Int            @map("target_time_seconds")
  coverageStatus         CoverageStatus @default(uncovered) @map("coverage_status")

  concept              Concept               @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  examinerLensAnalysis ExaminerLensAnalysis  @relation(fields: [examinerLensAnalysisId], references: [id], onDelete: Cascade)
  patternFamily        QuestionPatternFamily @relation(fields: [patternFamilyId], references: [id], onDelete: Cascade)
  trapErrorTaxonomy    ErrorTaxonomy?        @relation("TaxonomyCellTrap", fields: [trapErrorTaxonomyId], references: [id])
  questions            Question[]

  @@unique([conceptId, patternFamilyId, testingMode, trapErrorTaxonomyId, difficultyTier])
  @@index([conceptId])
  @@index([examinerLensAnalysisId])
  @@index([patternFamilyId])
  @@index([coverageStatus])
  @@map("pattern_taxonomy_cells")
}

// ---------------------------------------------------------------------
// Provenance — mandatory before a Question can be published
// ---------------------------------------------------------------------

enum SourceType {
  original
  licensed
  public_domain
  open_license
  official
  user_authorized
}

model Provenance {
  id           String     @id @default(uuid())
  sourceType   SourceType @map("source_type")
  sourceRef    String?    @map("source_ref")
  licenseRef   String?    @map("license_ref")
  attributedTo String?    @map("attributed_to")
  createdAt    DateTime   @default(now()) @map("created_at")

  questions Question[]

  @@map("provenances")
}

// ---------------------------------------------------------------------
// Question + Question DNA (docs/QUESTION_ENGINE.md §4)
// A CHECK constraint enforcing "published requires provenance" is added
// by hand in the initial migration SQL (Prisma's schema DSL has no
// conditional-NOT-NULL / CHECK syntax) — see the migration file.
// ---------------------------------------------------------------------

enum ValidationState {
  draft
  ai_validated
  human_reviewed
  published
  rejected
}

// Used for filtering novelty-handling practice/mastery (docs/PRODUCT_SPEC.md
// §3) — distinct from TestingMode, which classifies authoring technique
// rather than student-facing familiarity.
enum NoveltyLevel {
  standard
  novel_representation
  novel_combination
  novel_context
}

// How typical this pattern is of the actual exam, vs. good enrichment practice.
enum ExamRelevance {
  core
  peripheral
  stretch
}

model Question {
  id                     String          @id @default(uuid())
  examId                 String          @map("exam_id")
  sectionId              String          @map("section_id")
  chapterId              String          @map("chapter_id")
  conceptId              String          @map("concept_id")
  subconcepts            String[]
  prerequisites          String[]
  combinesWithConceptIds String[]        @map("combines_with_concept_ids")
  patternTaxonomyCellId  String          @map("pattern_taxonomy_cell_id")
  skill                  String
  difficultyTier         DifficultyTier  @map("difficulty_tier")
  difficultyDimensions   Json            @map("difficulty_dimensions")
  noveltyLevel           NoveltyLevel    @default(standard) @map("novelty_level")
  examRelevance          ExamRelevance   @default(core) @map("exam_relevance")
  expectedTimeSeconds    Int             @map("expected_time_seconds")
  testingModes           TestingMode[]   @map("testing_modes")
  trapErrorTaxonomyId    String?         @map("trap_error_taxonomy_id")
  body                   String
  options                Json
  correctAnswer          String          @map("correct_answer")
  solutionSteps          Json            @map("solution_steps")
  groundTruthDerivation  Json            @map("ground_truth_derivation")
  validationState        ValidationState @default(draft) @map("validation_state")
  provenanceId           String?         @map("provenance_id")
  createdAt              DateTime        @default(now()) @map("created_at")

  exam                Exam                @relation(fields: [examId], references: [id])
  section             Section             @relation(fields: [sectionId], references: [id])
  chapter             Chapter             @relation(fields: [chapterId], references: [id])
  concept             Concept             @relation("QuestionConcept", fields: [conceptId], references: [id])
  patternTaxonomyCell PatternTaxonomyCell @relation(fields: [patternTaxonomyCellId], references: [id])
  trapErrorTaxonomy   ErrorTaxonomy?      @relation("QuestionTrap", fields: [trapErrorTaxonomyId], references: [id])
  provenance          Provenance?         @relation(fields: [provenanceId], references: [id])
  attempts            Attempt[]

  @@index([conceptId])
  @@index([patternTaxonomyCellId])
  @@index([validationState])
  @@map("questions")
}

// ---------------------------------------------------------------------
// Student & Enrollment — Phase 1 foundation, not deferred
// (docs/DATABASE.md "Student & Enrollment (Phase 1 foundation)")
// ---------------------------------------------------------------------

model Student {
  id        String   @id @default(uuid())
  authRef   String?  @unique @map("auth_ref")
  createdAt DateTime @default(now()) @map("created_at")

  enrollments   Enrollment[]
  attempts      Attempt[]
  repairPlans   RepairPlan[]
  masteryStates MasteryState[]
  catchUpPlans  CatchUpPlan[]

  @@map("students")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  examId     String   @map("exam_id")
  enrolledAt DateTime @map("enrolled_at")

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts     Attempt[]
  catchUpPlans CatchUpPlan[]

  @@unique([studentId, examId])
  @@index([examId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------
// Attempt & AttemptEvent — event-sourced timing (docs/DECISIONS.md D-010)
// AttemptEvent is the source of truth; Attempt's own timestamp/count
// fields are denormalized convenience only.
// ---------------------------------------------------------------------

enum ReasoningInputMode {
  text
  voice
}

// The attempt lifecycle (docs/QUESTION_ENGINE.md / docs/DECISIONS.md D-034):
// an attempt is `in_progress` from startAttempt() until exactly one terminal
// transition finalizes it. `submitted` and `skipped` are both reached only
// through an explicit student action; `abandoned` is reserved for a future
// session/timeout close-out path (Phase 4A does not build that trigger, only
// the state it would set — see packages/domain/attempt). All three terminal
// states are equally final: no code path re-opens a finalized attempt.
enum AttemptStatus {
  in_progress
  submitted
  skipped
  abandoned
}

model Attempt {
  id                 String             @id @default(uuid())
  studentId          String             @map("student_id")
  questionId         String             @map("question_id")
  enrollmentId       String             @map("enrollment_id")
  retryOfAttemptId   String?            @map("retry_of_attempt_id")
  status             AttemptStatus      @default(in_progress)
  startedAt          DateTime           @map("started_at")
  submittedAt        DateTime?          @map("submitted_at")
  finalizedAt        DateTime?          @map("finalized_at")
  timeSpentSeconds   Int?               @map("time_spent_seconds")
  chosenAnswer       String?            @map("chosen_answer")
  isCorrect          Boolean?           @map("is_correct")
  hintsUsed          Int                @default(0) @map("hints_used")
  solutionOpenedAt   DateTime?          @map("solution_opened_at")
  workingSteps       Json?              @map("working_steps")
  reasoningText      String?            @map("reasoning_text")
  reasoningInputMode ReasoningInputMode @default(text) @map("reasoning_input_mode")
  reasoningAudioRef  String?            @map("reasoning_audio_ref")
  createdAt          DateTime           @default(now()) @map("created_at")

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id])
  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  retryOf    Attempt?       @relation("AttemptRetry", fields: [retryOfAttemptId], references: [id])
  retries    Attempt[]      @relation("AttemptRetry")
  events     AttemptEvent[]
  autopsy    Autopsy?

  @@index([studentId])
  @@index([questionId])
  @@index([enrollmentId])
  @@index([retryOfAttemptId])
  @@index([status])
  @@map("attempts")
}

// Canonical observable-behavior vocabulary (docs/DECISIONS.md D-034,
// Phase 4A). Renamed from Phase 1's `option_selected`/`option_changed`/
// `hint_requested` to `answer_selected`/`answer_changed`/`hint_opened` to
// match the canonical names used across the domain layer and docs — safe
// because no environment has ever applied a migration against a live
// database (see docs/MASTER_PLAN.md "Current state"), so this is a rename,
// not a backward-incompatible data migration. `working_input_changed` and
// `reasoning_submitted` are unchanged and remain reserved for Phase 5
// (docs/DECISIONS.md D-011) — Phase 4A's domain logic does not read or
// write them. Every value here names an OBSERVABLE ACTION, never an
// inferred mental state — see packages/domain/attempt/src/types.ts.
enum AttemptEventType {
  question_opened
  answer_selected
  answer_changed
  hint_opened
  solution_opened
  question_skipped
  working_input_changed
  reasoning_submitted
  answer_submitted
}

model AttemptEvent {
  id         String           @id @default(uuid())
  attemptId  String           @map("attempt_id")
  eventType  AttemptEventType @map("event_type")
  payload    Json?
  occurredAt DateTime         @map("occurred_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([attemptId, occurredAt])
  @@map("attempt_events")
}

// ---------------------------------------------------------------------
// Error Taxonomy — data, not a free-form string (docs/DECISIONS.md D-012)
// ---------------------------------------------------------------------

// The 5 broad "what can go wrong" categories (docs/QUESTION_ENGINE.md §2)
// — the SAME vocabulary Examiner Lens error modes use
// (packages/domain/examiner-lens), so Autopsy diagnosis and Lens-authored
// traps share one error vocabulary instead of two (docs/DECISIONS.md D-013).
enum ErrorCategory {
  misconception
  trap
  calculation_mistake
  interpretation_mistake
  method_selection_mistake
}

model ErrorTaxonomy {
  id          String        @id @default(uuid())
  code        String        @unique
  label       String
  description String?
  category    ErrorCategory

  autopsies         Autopsy[]
  repairPlans       RepairPlan[]
  taxonomyCellTraps PatternTaxonomyCell[] @relation("TaxonomyCellTrap")
  questionTraps     Question[]            @relation("QuestionTrap")

  @@map("error_taxonomies")
}

// ---------------------------------------------------------------------
// Question Autopsy — hypothesis until confirmed (docs/DECISIONS.md D-006)
// ---------------------------------------------------------------------

model Autopsy {
  id                    String   @id @default(uuid())
  attemptId             String   @unique @map("attempt_id")
  hypothesisText        String   @map("hypothesis_text")
  errorTaxonomyId       String?  @map("error_taxonomy_id")
  likelyRootCause       String?  @map("likely_root_cause")
  evidenceUsed          Json     @map("evidence_used")
  confirmed             Boolean? @map("confirmed")
  studentCorrectionText String?  @map("student_correction_text")
  generatedByProvider   String   @map("generated_by_provider")
  promptVersion         String   @map("prompt_version")
  createdAt             DateTime @default(now()) @map("created_at")

  attempt       Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  errorTaxonomy ErrorTaxonomy? @relation(fields: [errorTaxonomyId], references: [id])
  repairPlans   RepairPlan[]

  @@index([errorTaxonomyId])
  @@map("autopsies")
}

enum RepairStatus {
  pending
  in_progress
  completed
}

model RepairPlan {
  id                    String       @id @default(uuid())
  autopsyId             String       @map("autopsy_id")
  studentId             String       @map("student_id")
  targetConceptId       String       @map("target_concept_id")
  targetErrorTaxonomyId String?      @map("target_error_taxonomy_id")
  followUpQuestionIds   String[]     @map("follow_up_question_ids")
  status                RepairStatus @default(pending)
  createdAt             DateTime     @default(now()) @map("created_at")

  autopsy       Autopsy        @relation(fields: [autopsyId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  errorTaxonomy ErrorTaxonomy? @relation(fields: [targetErrorTaxonomyId], references: [id])

  @@index([autopsyId])
  @@index([studentId])
  @@map("repair_plans")
}

// ---------------------------------------------------------------------
// Mastery — derived only, never input (docs/DATABASE.md "Mastery" rule)
// ---------------------------------------------------------------------

// componentDetail (Phase 5B, docs/DECISIONS.md D-040) holds the rich,
// never-discarded breakdown @ipmat/mastery's MasteryComponentDetail
// computes alongside the 5 scalar columns below — total/correct/incorrect
// counts, speed statistics, accuracy stability (stddev, not just mean),
// difficulty/novelty/pressure breakdowns, error-recurrence streaks, and
// coverage detail.
//
// The 5 scalar columns are nullable as of Phase 5C-1 (docs/DECISIONS.md
// D-043, migration 0005_mastery_state_nullable_measures) — this is the
// resolution to the tension D-042 left open. NULL means exactly what
// `MasteryComponentMeasures`'s `null` means: insufficient data for that
// specific dimension (fewer than MASTERY_CONSTANTS.MIN_OBSERVATIONS_FOR_
// COMPONENT relevant observations), never coerced to 0. A real 0.0 means
// the dimension WAS measured and the measured value is genuinely zero.
// See @ipmat/mastery's toMasteryStatePersistenceRecord() for the full
// three-state model (row absent / column NULL / column a real number).
model MasteryState {
  id                  String   @id @default(uuid())
  studentId           String   @map("student_id")
  conceptId           String   @map("concept_id")
  accuracy            Float?
  speedRatio          Float?   @map("speed_ratio")
  noveltyHandling     Float?   @map("novelty_handling")
  pressurePerformance Float?   @map("pressure_performance")
  patternCoverage     Float?   @map("pattern_coverage")
  componentDetail     Json     @map("component_detail")
  computedAt          DateTime @map("computed_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
  @@index([studentId])
  @@index([conceptId])
  @@map("mastery_states")
}

// ---------------------------------------------------------------------
// Calendar-aware preparation — Phase 1 foundation (docs/DECISIONS.md D-009)
// ---------------------------------------------------------------------

model PrepPhaseTemplate {
  id         String @id @default(uuid())
  examId     String @map("exam_id")
  phaseCurve Json   @map("phase_curve")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId])
  @@map("prep_phase_templates")
}

model CatchUpPlan {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  enrollmentId String   @map("enrollment_id")
  overlay      Json
  createdAt    DateTime @default(now()) @map("created_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([enrollmentId])
  @@map("catch_up_plans")
}
