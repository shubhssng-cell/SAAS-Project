{
  "name": "@ipmat/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/migrations/0001_init/migration.sql",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@ipmat/ai": "*",
    "@ipmat/ai-orchestration": "*",
    "@ipmat/attempt": "*",
    "@ipmat/autopsy": "*",
    "@ipmat/concept-graph": "*",
    "@ipmat/content-authoring": "*",
    "@ipmat/content-intelligence": "*",
    "@ipmat/exam-intelligence": "*",
    "@ipmat/exam-pack": "*",
    "@ipmat/exam-simulation": "*",
    "@ipmat/examiner-intelligence": "*",
    "@ipmat/examiner-lens": "*",
    "@ipmat/mastery": "*",
    "@ipmat/personalization": "*",
    "@ipmat/prep-phase": "*",
    "@ipmat/practice-block": "*",
    "@ipmat/practice-session": "*",
    "@ipmat/question-engine": "*",
    "@ipmat/question-generation": "*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1"
  }
}
