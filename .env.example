ANTHROPIC_API_KEY=

# --- apps/api (Phase 9 Unit 3). All server-side; none of these is ever sent to the browser. ---
# Which AI provider the API uses: none (default; the tutor answers "not available"), anthropic, or dev-scripted (development only).
# IPMAT_AI_PROVIDER=none
# IPMAT_AI_MODEL=                       # required with anthropic; there is no default model
# Browser origins allowed to make state-changing requests, comma-separated, no wildcard (REQUIRED when NODE_ENV=production).
# IPMAT_ALLOWED_ORIGINS=https://app.example.com
# Set to true ONLY behind a proxy that overwrites X-Forwarded-For (the last hop is then used as the client address).
# IPMAT_TRUST_PROXY=false
# IPMAT_LOG_LEVEL=info                  # debug | info | warn | error

# --- apps/api commercial layer (Phase 9 Unit 4, D-100). Server-side only. ---
# open = no commercial restriction (development default); enforced = access follows the plan catalog. REQUIRED when NODE_ENV=production.
# IPMAT_ENTITLEMENTS=open
# The plan catalog (JSON). REQUIRED when enforced. The repository ships no plan, price or baseline: plans/prices/limits are business decisions.
# Shape: {"baseline":{"exams":[...],"features":[...],"usageLimits":[...]},"plans":[{"id","name","description","active","provisional","exams","features","usageLimits","durationDays","price":{"amountMinor","currency","providerPriceRef"}|null}]}
# IPMAT_BILLING_CATALOG=
# Payment provider adapter name. Only "none" exists in this build (checkout unavailable); any other value is refused at startup.
# IPMAT_PAYMENT_PROVIDER=none
# Where the provider returns the browser after payment (https; http only for localhost outside production). Returning proves nothing.
# IPMAT_CHECKOUT_RETURN_URL=https://app.example.com/billing?checkout=return
